{
  "name": "gn-drive-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:dev": "vue-tsc -b && vite build --mode development --sourcemap",
    "build:watch": "vite build --watch --mode development --sourcemap",
    "preview": "vite preview",
    "lint": "vue-tsc --noEmit",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:coverage": "E2E_COVERAGE=1 node scripts/e2e-run.mjs --coverage",
    "test:e2e:headed": "HEADED=1 node scripts/e2e-run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@tanstack/vue-virtual": "^3.13.47",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "clsx": "^2.1.1",
    "pinia": "^4.1.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "nyc": "^18.0.0",
    "puppeteer": "^25.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.13"
  }
}
